@model fastwriter.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card auth-card">
            <div class="card-body p-4">
                <h3 class="mb-1">Giriş Yap</h3>
                <p class="text-secondary mb-4">Skorlarını kaydetmek ve geçmişini görmek için giriş yap.</p>

                @if (TempData["Error"] is string tempError)
                {
                    <div class="alert alert-danger">@tempError</div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@eposta.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                </form>

                <div class="text-center my-3 text-secondary">veya</div>

                @if (ViewBag.GoogleEnabled == true)
                {
                    <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                        <input type="hidden" name="provider" value="Google" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-outline-light w-100">
                            <span class="fw-bold" style="color:#4285F4;">G</span> Google ile giriş yap
                        </button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary w-100" disabled>
                        <span class="fw-bold">G</span> Google ile giriş yap
                    </button>
                    <p class="text-secondary small mt-2 mb-0">
                        Google girişi için <code>appsettings.json</code> içindeki
                        <code>Authentication:Google</code> anahtarlarını doldurman gerekir.
                    </p>
                }

                <p class="mt-4 mb-0">
                    Hesabın yok mu?
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Kayıt ol</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
