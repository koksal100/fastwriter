@model fastwriter.ViewModels.LeaderboardViewModel
@{
    ViewData["Title"] = "Liderlik Tablosu";

    string TabClass(string value) => Model.Period == value ? "nav-link active" : "nav-link";
    string Medal(int rank) => rank switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        _ => $"#{rank}"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-3">
    <div>
        <h2 class="mb-1">Liderlik Tablosu</h2>
        <p class="text-secondary mb-0">Tüm yarışmacıların en iyi 3 dakikalık denemeleri.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Teste Gir</a>
</div>

<ul class="nav nav-pills leaderboard-tabs mb-3">
    <li class="nav-item">
        <a class="@TabClass("all")" asp-action="Index" asp-route-period="all">Tüm Zamanlar</a>
    </li>
    <li class="nav-item">
        <a class="@TabClass("week")" asp-action="Index" asp-route-period="week">Bu Hafta</a>
    </li>
    <li class="nav-item">
        <a class="@TabClass("today")" asp-action="Index" asp-route-period="today">Son 24 Saat</a>
    </li>
</ul>

@if (User.Identity?.IsAuthenticated == true)
{
    if (Model.CurrentUserEntry is not null)
    {
        <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>
                Senin sıran: <strong>#@Model.CurrentUserEntry.Rank</strong> —
                <strong>@Model.CurrentUserEntry.NetWpm WPM</strong>,
                %@Model.CurrentUserEntry.Accuracy.ToString("0.##") doğruluk
            </span>
            <span class="text-secondary small">@Model.CurrentUserEntry.AttemptCount deneme</span>
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            Bu dönemde liderlik tablosuna girecek bir skorun yok.
            3 dakikalık bir testi tamamlayınca otomatik olarak burada görüneceksin.
        </div>
    }
}
else
{
    <div class="alert alert-secondary d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>Sen de sıralamaya girmek için giriş yap ve 3 dakikalık testi tamamla.</span>
        <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Leaderboard">Giriş Yap</a>
    </div>
}

@if (Model.Entries.Count == 0)
{
    <div class="card bg-dark border-secondary">
        <div class="card-body text-center py-5">
            <h4>Henüz liderlik tablosunda skor yok</h4>
            <p class="text-secondary mb-3">
                Liderlik tablosuna yalnızca 180 saniyelik tamamlanmış denemeler dahil edilir.
            </p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">İlk Skoru Sen Kaydet</a>
        </div>
    </div>
}
else
{
    @if (Model.Entries.Count >= 3)
    {
        <div class="row g-3 mb-4">
            @foreach (var entry in Model.Entries.Take(3))
            {
                <div class="col-md-4">
                    <div class="card stat-card h-100 text-center @(entry.UserId == Model.CurrentUserId ? "leaderboard-current" : "")">
                        <div class="card-body">
                            <div class="leaderboard-medal">@Medal(entry.Rank)</div>
                            <h5 class="mt-2 mb-1 text-truncate" title="@entry.DisplayName">@entry.DisplayName</h5>
                            <div class="stat-value text-info">@entry.NetWpm <small class="fs-6">WPM</small></div>
                            <div class="text-secondary">%@entry.Accuracy.ToString("0.##") doğruluk</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="table-responsive card bg-dark border-secondary">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;">Sıra</th>
                    <th>Yarışmacı</th>
                    <th class="text-end">Net WPM</th>
                    <th class="text-end">Ham WPM</th>
                    <th class="text-end">Doğruluk</th>
                    <th class="text-end">Doğru Kelime</th>
                    <th class="text-end">Deneme</th>
                    <th class="text-end">Tarih</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr class="@(entry.UserId == Model.CurrentUserId ? "leaderboard-current" : "")">
                        <td class="fw-bold">@Medal(entry.Rank)</td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 220px;" title="@entry.DisplayName">
                                @entry.DisplayName
                            </span>
                            @if (entry.UserId == Model.CurrentUserId)
                            {
                                <span class="badge bg-primary ms-1">Sen</span>
                            }
                        </td>
                        <td class="text-end fw-bold text-success">@entry.NetWpm</td>
                        <td class="text-end">@entry.RawWpm</td>
                        <td class="text-end">%@entry.Accuracy.ToString("0.##")</td>
                        <td class="text-end">@entry.CorrectWords</td>
                        <td class="text-end text-secondary">@entry.AttemptCount</td>
                        <td class="text-end text-secondary">@entry.AchievedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-secondary small mt-3 mb-0">
        Sıralama, her kullanıcının en iyi net WPM değerine göre yapılır. Eşitlik durumunda doğruluk oranı yüksek olan öne geçer.
        Tabloya yalnızca 180 saniyelik tamamlanmış denemeler dahil edilir.
    </p>
}
